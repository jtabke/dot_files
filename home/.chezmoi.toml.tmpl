{{- $kernel := lower (default "" (index .chezmoi.kernel "osrelease")) -}}
{{- $isWSL := or (contains "microsoft" $kernel) (contains "wsl" $kernel) -}}
{{- $osReleaseID := lower (default "" (index .chezmoi.osRelease "id")) -}}
{{- $role := "shell" -}}
{{- $desktop := "none" -}}
{{- if $isWSL -}}
{{- warnf "WSL detected: shell/CLI only; skipping role and desktop questions." -}}
{{- else -}}
{{- $role = promptChoiceOnce . "role" "Machine role" (list "workstation" "shell") -}}
{{- if eq $role "workstation" -}}
{{- $choices := list "none" -}}
{{- if eq .chezmoi.os "linux" -}}
{{- $choices = list "auto" "hyprland" "none" -}}
{{- else if eq .chezmoi.os "darwin" -}}
{{- $choices = list "auto" "aerospace" "none" -}}
{{- end -}}
{{- $desktop = promptChoiceOnce . "desktop" "Desktop environment" $choices -}}
{{- end -}}
{{- end -}}
{{- warnf "Profile: %s / %s. Desktop profiles configure an existing desktop; they do not install one." $role $desktop -}}
{{- warnf "Optional packages: Git, Git LFS, Neovim, zsh, tmux, ripgrep, fzf, Node/npm, C compiler, make, curl, unzip. Fuzzel only on native Linux Hyprland. Run scripts/setup.sh --plan after init for the exact missing-package plan. Apply asks for approval before installing; old tool versions are reported, not automatically upgraded." -}}
{{- $installPackages := promptBoolOnce . "installPackages" "Install missing packages during apply?" -}}
{{- $autoTmux := promptBoolOnce . "autoTmux" "Automatically attach interactive shells to tmux?" -}}
[data]
    role = {{ $role | quote }}
    desktop = {{ $desktop | quote }}
    installPackages = {{ $installPackages }}
    autoTmux = {{ $autoTmux }}
    isWSL = {{ $isWSL }}
    osReleaseID = {{ $osReleaseID | quote }}

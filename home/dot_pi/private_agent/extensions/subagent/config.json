{
  "toolDescriptionMode": "compact",
  "asyncByDefault": true,
  "forceTopLevelAsync": true,
  "waitTool": {
    "enabled": true
  },
  "toolTimeoutMs": 600000,
  "resultScanLogging": "activity",
  "fleetView": true,
  "globalConcurrencyLimit": 3,
  "maxActiveAsyncRunsPerSession": 3,
  "maxSubagentSpawnsPerSession": 24,
  "maxSubagentSpawnsPerRun": 6,
  "artifactDir": "session",
  "maxSubagentDepth": 1,
  "missions": {
    "enabled": true,
    "globalIndex": true,
    "retainTerminal": 100
  },
  "intercomBridge": {
    "mode": "always",
    "resultDelivery": false
  },
  "parallel": {
    "concurrency": 3,
    "maxTasks": 6
  },
  "completionBatch": {
    "enabled": true
  },
  "control": {
    "enabled": true,
    "needsAttentionAfterMs": 180000,
    "activeNoticeAfterMs": 300000,
    "activeNoticeAfterTurns": 10,
    "failedToolAttemptsBeforeAttention": 2,
    "notifyOn": ["needs_attention", "active_long_running"],
    "notifyChannels": ["event", "async", "intercom"]
  }
}

{
  "toolDescriptionMode": "compact",
  "asyncByDefault": true,
  "forceTopLevelAsync": true,
  "waitTool": {
    "enabled": false
  },
  "toolTimeoutMs": 600000,
  "resultScanLogging": "activity",
  "fleetView": true,
  "globalConcurrencyLimit": 4,
  "maxActiveAsyncRunsPerSession": 3,
  "capacity": {
    "abandonedSlotReleaseAfterMs": 1200000
  },
  "maxSubagentSpawnsPerSession": 48,
  "maxSubagentSpawnsPerRun": 12,
  "artifactDir": "session",
  "maxSubagentDepth": 1,
  "missions": {
    "enabled": true,
    "globalIndex": true,
    "retainTerminal": 100
  },
  "intercomBridge": {
    "mode": "always",
    "resultDelivery": false
  },
  "parallel": {
    "concurrency": 4,
    "maxTasks": 12
  },
  "completionBatch": {
    "enabled": true
  },
  "control": {
    "enabled": true,
    "activeNoticeAfterMs": 300000,
    "failedToolAttemptsBeforeAttention": 3,
    "notifyOn": [
      "needs_attention",
      "active_long_running"
    ],
    "notifyChannels": [
      "event",
      "async",
      "intercom"
    ]
  },
  "disabledFeatures": [
    "external-machines",
    "panes",
    "agent-management",
    "tool-budgets",
    "usage-budgets"
  ],
  "scheduledRuns": {
    "enabled": false
  }
}

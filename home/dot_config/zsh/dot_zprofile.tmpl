# Login-only platform setup.
{{- if and (eq .chezmoi.os "darwin") }}
if command -v brew >/dev/null 2>&1; then
  eval "$(brew shellenv)"
elif [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
fi
{{- end }}
export PI_CACHE_RETENTION=long
{{- $kernel := lower .chezmoi.kernel.osrelease -}}
{{- $isWSL := or (contains $kernel "microsoft") (contains $kernel "wsl") -}}
{{- if and (eq .role "workstation") (eq .chezmoi.os "linux") (not $isWSL) (or (eq .desktop "auto") (eq .desktop "hyprland")) }}
# Never start a graphical compositor in WSL. This block is rendered only for
# native Linux Hyprland profiles.
if [[ -z "${DISPLAY-}" && -z "${WAYLAND_DISPLAY-}" && "${XDG_VTNR-}" == 1 ]] && command -v Hyprland >/dev/null 2>&1; then
  exec Hyprland
fi
{{- end }}

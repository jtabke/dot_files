# Login-only platform setup.
{{- if and (eq .chezmoi.os "darwin") }}
if command -v brew >/dev/null 2>&1; then
  eval "$(brew shellenv)"
elif [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
fi
{{- end }}
export PI_CACHE_RETENTION=long
{{- $kernel := lower (default "" (index .chezmoi.kernel "osrelease")) -}}
{{- $isWSL := or (contains "microsoft" $kernel) (contains "wsl" $kernel) -}}
{{- if and (eq .role "workstation") (eq .chezmoi.os "linux") (not $isWSL) (or (eq .desktop "auto") (eq .desktop "hyprland")) }}
# Never start a compositor from tmux, SSH, a pseudo-terminal, or WSL. This
# block is rendered only for native Linux Hyprland workstation profiles.
if [[ -z "${TMUX-}" && -z "${SSH_CONNECTION-}" && -z "${SSH_TTY-}" \
  && -z "${DISPLAY-}" && -z "${WAYLAND_DISPLAY-}" \
  && "${XDG_VTNR-}" == 1 && -t 0 && -t 1 \
  && "$(tty 2>/dev/null)" == /dev/tty1 ]]; then
  if command -v start-hyprland >/dev/null 2>&1; then
    exec start-hyprland
  elif command -v Hyprland >/dev/null 2>&1; then
    exec Hyprland
  fi
fi
{{- end }}

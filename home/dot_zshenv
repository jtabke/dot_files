# .zshenv is sourced by every zsh invocation. Keep it side-effect-light.
export ZDOTDIR="$HOME/.config/zsh"
typeset -U path PATH
for directory in \
  "$HOME/.npm-global/bin" \
  "$HOME/.opencode/bin" \
  "$HOME/.bun/bin" \
  "$HOME/.local/share/nvim/mason/bin" \
  "$HOME/.local/bin"; do
  [[ -d "$directory" ]] && path=("$directory" $path)
done
[[ -d /opt/rocm/bin ]] && path+=(/opt/rocm/bin)
unset directory
[[ -f "$HOME/.local/bin/env" ]] && . "$HOME/.local/bin/env"
if [[ -z "${EDITOR-}" ]]; then
  if command -v nvim >/dev/null 2>&1; then export EDITOR=nvim
  else export EDITOR=vi
  fi
fi
if [[ -z "${BROWSER-}" ]]; then
  if [[ "$OSTYPE" == darwin* ]]; then export BROWSER=open
  elif [[ -n "${WSL_DISTRO_NAME-}" ]] && command -v wslview >/dev/null 2>&1; then export BROWSER=wslview
  elif [[ -n "${DISPLAY-}${WAYLAND_DISPLAY-}" ]] && command -v xdg-open >/dev/null 2>&1; then export BROWSER=xdg-open
  fi
fi
if [[ -z "${TERMINAL-}" ]] && command -v ghostty >/dev/null 2>&1; then
  export TERMINAL=ghostty
fi
export NEXT_TELEMETRY_DISABLED=1

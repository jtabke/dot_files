{
  "defaultModel": "gpt-6.1-sol",
  "defaultProvider": "openai",
  "defaultThinkingLevel": "medium",
  "defaultTools": [
    "+codemode"
  ],
  "enableInstallTelemetry": false,
  "hideThinkingBlock": false,
  "markdown": {
    "mermaid": "streaming"
  },
  "packages": [
    "npm:pi-web-access",
    "git:github.com/jtabke/pi-extensions",
    "npm:pi-codex-image-gen",
    "git:github.com/jtabke/pi-vim",
    "git:github.com/jtabke/pi-companion",
    {
      "source": "npm:pi-subagents",
      "skills": [
        "!skills/pi-subagents/**"
      ]
    }
  ],
  "subagents": {
    "agentOverrides": {
      "delegate": {
        "defaultContext": "fresh",
        "model": "openai/gpt-6.1-sol",
        "thinking": "low",
        "inheritGlobalContext": false,
        "inheritSkills": false
      },
      "oracle": {
        "acceptanceRole": "read-only",
        "defaultContext": "fork",
        "model": "openai/gpt-6.1-sol",
        "thinking": "high",
        "inheritGlobalContext": false,
        "inheritSkills": false
      },
      "researcher": {
        "acceptanceRole": "read-only",
        "defaultContext": "fresh",
        "inheritProjectContext": false,
        "model": "openai/gpt-6-luna",
        "thinking": "high",
        "inheritGlobalContext": false,
        "inheritSkills": false
      },
      "reviewer": {
        "acceptanceRole": "read-only",
        "defaultContext": "fresh",
        "model": "openai/gpt-6.1-sol",
        "thinking": "medium",
        "inheritGlobalContext": false,
        "inheritSkills": false
      },
      "scout": {
        "acceptanceRole": "read-only",
        "defaultContext": "fresh",
        "model": "openai/gpt-6-luna",
        "thinking": "medium",
        "inheritGlobalContext": false,
        "inheritSkills": false
      },
      "worker": {
        "acceptanceRole": "writer",
        "defaultContext": "fresh",
        "model": "openai/gpt-6.1-sol",
        "thinking": "medium",
        "inheritGlobalContext": false,
        "inheritSkills": false
      }
    },
    "defaultModel": "openai/gpt-6.1-sol",
    "defaultThinking": "medium"
  },
  "theme": "dark",
  "tuiMode": "fullscreen"
}

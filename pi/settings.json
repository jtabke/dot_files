{
  "theme": "dark",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-sol",
  "defaultThinkingLevel": "medium",
  "hideThinkingBlock": true,
  "subagents": {
    "defaultModel": "openai-codex/gpt-5.6-luna",
    "defaultThinking": "high",
    "agentOverrides": {
      "scout": {
        "model": "openai-codex/gpt-5.6-luna",
        "thinking": "high"
      },
      "context-builder": {
        "model": "openai-codex/gpt-5.6-luna",
        "thinking": "high"
      },
      "researcher": {
        "model": "openai-codex/gpt-5.6-luna",
        "thinking": "high"
      },
      "delegate": {
        "model": "openai-codex/gpt-5.6-luna",
        "thinking": "max"
      },
      "worker": {
        "model": "openai-codex/gpt-5.6-luna",
        "thinking": "max"
      },
      "reviewer": {
        "model": "openai-codex/gpt-5.6-sol",
        "thinking": "medium"
      },
      "planner": {
        "model": "openai-codex/gpt-5.6-sol",
        "thinking": "medium"
      },
      "oracle": {
        "model": "openai-codex/gpt-5.6-sol",
        "thinking": "medium"
      },
      "advisor": {
        "model": "openai-codex/gpt-5.6-sol",
        "thinking": "medium"
      }
    }
  },
  "packages": [
    "npm:pi-subagents",
    "npm:pi-web-access",
    "npm:pi-mcp-adapter",
    "npm:context-mode"
  ],
  "enableInstallTelemetry": false,
  "markdown": {
    "mermaid": "streaming"
  },
  "tuiMode": "fullscreen"
}